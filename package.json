{
  "name": "microsoft-sentinel-easypivot",
  "version": "0.1.0",
  "description": "Right-click IOC pivoting for MS Sentinel / Defender Advanced Hunting",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "harness": "esbuild harness/harness.ts --bundle --format=esm --loader:.json=json --define:__SCRIPT_VERSION__='\"harness\"' --outfile=harness/harness.js",
    "harness:drive": "npm run harness && node harness/drive.mjs",
    "harness:check": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --strict --allowImportingTsExtensions --skipLibCheck harness/harness.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
